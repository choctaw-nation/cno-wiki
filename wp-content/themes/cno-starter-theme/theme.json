{
	"version": 3,
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"settings": {
		"appearanceTools": true,
		"color": {
			"background": true,
			"customDuotone": false,
			"customGradient": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"slug": "primary",
					"color": "#512d6d",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#6c757d",
					"name": "Secondary"
				},
				{
					"slug": "dark",
					"color": "#221c45",
					"name": "Dark"
				},
				{
					"slug": "white",
					"color": "#fff",
					"name": "White"
				},
				{
					"slug": "black",
					"color": "#000",
					"name": "Black"
				},
				{
					"slug": "success",
					"color": "#198754",
					"name": "Success"
				},
				{
					"slug": "info",
					"color": "#0dcaf0",
					"name": "Info"
				},
				{
					"slug": "warning",
					"color": "#ffc107",
					"name": "Warning"
				},
				{
					"slug": "danger",
					"color": "#dc3545",
					"name": "Danger"
				}
			]
		},
		"dimensions": {
			"aspectRatio": true,
			"minHeight": true
		},
		"layout": {
			"contentSize": "768px",
			"wideSize": "1320px"
		},
		"spacing": {
			"blockGap": true,
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"margin": true,
			"padding": true,
			"spacingSizes": [
				{
					"name": "Extra Small",
					"size": ".25rem",
					"slug": "xs"
				},
				{
					"name": "Small",
					"size": ".5rem",
					"slug": "sm"
				},
				{
					"name": "Base",
					"size": "1rem",
					"slug": "base"
				},
				{
					"name": "Large",
					"size": "1.5rem",
					"slug": "lg"
				},
				{
					"name": "Extra Large",
					"size": "3rem",
					"slug": "xl"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"lineHeight": false,
			"dropCap": false,
			"fluid": true,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"textDecoration": true,
			"textTransform": true,
				"fontSizes": [
				{
					"slug": "xs",
					"size": ".833rem",
					"name": "Extra Small",
					"fluid": {
						"min": ".833rem",
						"max": "1.04rem"
					}
				},
				{
					"slug": "root",
					"size": "1rem",
					"name": "Root",
					"fluid": {
						"min": "1rem",
						"max": "1.25rem"
					}
				},
				{
					"slug": "sm",
					"size": "1.2rem",
					"name": "Small (H6)",
					"fluid": {
						"min": "1.2rem",
						"max": "1.5rem"
					}
				},
				{
					"slug": "md",
					"size": "1.44rem",
					"name": "Medium (H5)",
					"fluid": {
						"min": "1.44rem",
						"max": "1.88rem"
					}
				},
				{
					"slug": "lg",
					"size": "1.728rem",
					"name": "Large (H4)",
					"fluid": {
						"min": "1.728rem",
						"max": "2.16rem"
					}
				},
				{
					"slug": "xl",
					"size": "2.074rem",
					"name": "XL (H3)",
					"fluid": {
						"min": "2.074rem",
						"max": "2.592rem"
					}
				},
				{
					"slug": "xxl",
					"size": "2.488rem",
					"name": "2XL (H2)",
					"fluid": {
						"min": "2.488rem",
						"max": "3.11rem"
					}
				},
				{
					"slug": "xxxl",
					"size": "2.986rem",
					"name": "3XL (H1)",
					"fluid": {
						"min": "2.986rem",
						"max": "3.73rem"
					}
				}
			],
			"fontFamilies": [
				{
					"slug": "gill-sans-nova",
					"name": "Gill Sans Nova",
					"fontFamily": "gill-sans-nova, \"Helvetica Neue\", \"Noto Sans\", \"Liberation Sans\", Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\""
				}
			]
		},
		"useRootPaddingAwareAlignments": true,
		"blocks": {
			"core/group": {
				"background": {
					"backgroundImage": true,
					"backgroundSize": true
				}
			}
		},
		"custom": {
			"lineHeight": "calc(4px + 2.5ex)",
			"transition": {
				"timing": "ease-in-out",
				"duration": ".15s",
				"standard": "var(--wp--custom--transition--duration) var(--wp--custom--transition--timing)"
			}
		}
	},
	"styles": {
		"spacing": {
			"padding": {
				"bottom": "0",
				"left": "calc(var(--wp--preset--spacing--lg) * .5)",
				"right": "calc(var(--wp--preset--spacing--lg) * .5)",
				"top": "0"
			}
		},
		"typography": {
			"fontSize": "var:preset|font-size|root",
			"fontFamily": "var:preset|font-family|gill-sans-nova",
			"lineHeight": "1.5",
			"fontWeight": "400"
		},
		"css": "text-wrap:pretty",
		"blocks": {
			"core/columns": {
				"spacing": { "blockGap": "var:preset|spacing|lg" }
			},
			"core/cover": {
				"spacing": {
					"padding": {
						"top": "0",
						"right": "0",
						"bottom": "0",
						"left": "0"
					},
					"blockGap": "var:preset|spacing|base"
				}
			},
			"core/group":{
				"spacing": {
					"blockGap": "0"
				}
			},
			"core/paragraph": {
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "var:preset|spacing|base"
					}
				}
			}
		},
		"elements": {
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xxxl"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|xxl"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|xl"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|lg"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|md"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|sm"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|headings",
					"fontWeight": "700",
					"lineHeight": "1.2"
				},
				"spacing": {
					"margin": {
						"bottom": "var:preset|spacing|sm",
						"top": "0"
					}
				},
				"css": "text-wrap:pretty"
			}
		}
	}
}
