{
	"name": "choctaw-nation/cno-wiki-theme",
	"description": "the wiki theme",
	"version": "1.3.0",
	"autoload": {
		"classmap":["inc/"]
	},
	"type": "project",
	"repositories": [
		{
			"type": "composer",
			"url": "https://wpackagist.org",
			"only": [
				"wpackagist-plugin/*",
				"wpackagist-theme/*"
			]
		}
	],
	"scripts": {
		"phpcs": "phpcs . --extensions=php --ignore=dist/,vendor/",
		"phpcbf": "phpcbf . --extensions=php --ignore=dist/,vendor/"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "*"
	}
}
