{
	"[javascript]": {
		"editor.formatOnSave": false
	},
	"[javascriptreact]": {
		"editor.formatOnSave": false
	},
	"[php]": {
		"editor.autoIndent": "advanced",
		"editor.defaultFormatter": "wongjn.php-sniffer",
		"editor.detectIndentation": true,
		"editor.formatOnSave": true,
		"editor.indentSize": "tabSize",
		"editor.insertSpaces": false,
		"editor.useTabStops": true,
		"prettier.tabWidth": 4,
		"prettier.useTabs": true
	},
	"[typescript]": {
		"editor.formatOnSave": false
	},
	"[typescriptreact]": {
		"editor.formatOnSave": false
	},
	"[yaml]": {
		"editor.autoIndent": "advanced",
		"editor.detectIndentation": true,
		"editor.indentSize": "tabSize",
		"editor.quickSuggestions": {
			"comments": false,
			"other": true,
			"strings": true
		},
		"editor.tabSize": 2,
		"editor.useTabStops": true,
		"prettier.useTabs": false
	},
	"cSpell.words": [
		"alignwide",
		"Appender",
		"atts",
		"autoloading",
		"autoptimize",
		"autoupdater",
		"bloginfo",
		"choctawnation",
		"choctawnationofoklahoma",
		"classmap",
		"Customizer",
		"gforms",
		"googlesitekit",
		"gravityforms",
		"gravityformsrecaptcha",
		"instantiator",
		"loginout",
		"mediapress",
		"megamenu",
		"metadesc",
		"muplugins",
		"nextpage",
		"NONBLOCKING",
		"pagenum",
		"prio",
		"relevanssi",
		"Squiz",
		"tagmanager",
		"trackbacks",
		"wordfence",
		"wpengine",
		"xxxxl"
	],
	"css.format.spaceAroundSelectorSeparator": true,
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "always",
		"source.fixAll.stylelint": "always"
	},
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"eslint.enable": true,
	"eslint.useESLintClass": true,
	"eslint.validate": [
		"javascript",
		"javascriptreact",
		"typescript",
		"typescriptreact",
		"html",
		"css",
		"scss"
	],
	"html.format.templating": true,
	"phpSniffer.standard": "wp-content/themes/cno-starter-theme/phpcs.xml.dist",
	"phpSniffer.executablesFolder": "wp-content/themes/cno-starter-theme/vendor/bin",
	"scss.format.spaceAroundSelectorSeparator": true,
	"stylelint.snippet": [ "css", "scss" ],
	"stylelint.validate": [ "css", "scss" ]
}
