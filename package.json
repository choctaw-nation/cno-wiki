{
	"name": "cno-wiki",
	"version": "1.3.0",
	"description": "Custom WP theme for CNO sites",
	"prettier": "@wordpress/prettier-config",
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"engines": {
		"node": ">=24",
		"npm": ">=12"
	},
	"scripts": {
		"build": "wp-scripts build --blocks-manifest --webpack-copy-php --source-path=wp-content/themes/cno-starter-theme/src/ --output-path=wp-content/themes/cno-starter-theme/dist/ --config webpack.config.mjs",
		"check-engines": "wp-scripts check-engines",
		"lint:css": "npx stylelint '**/*.scss' '**/*.css' --fix",
		"lint:js": "npx eslint --fix",
		"packages-update": "wp-scripts packages-update",
		"start": "wp-scripts start --blocks-manifest --webpack-copy-php --source-path=wp-content/themes/cno-starter-theme/src/ --output-path=wp-content/themes/cno-starter-theme/dist/ --config webpack.config.mjs",
		"audit-script": "sh ./tools/audit-npm-script-package.sh"
	},
	"author": "Choctaw Nation of Oklahoma",
	"license": "GPL-3.0-or-later",
	"dependencies": {
		"@choctawnationofoklahoma/wp-flex-reverse-toggle": "^2.0.0",
		"bootstrap": "^5.3.8",
		"swiper": "^14.3.0"
	},
	"devDependencies": {
		"@types/bootstrap": "^5.2.10",
		"@wordpress/scripts": "^37.0.0",
		"eslint": "^10.13.0",
		"globals": "^17.13.0",
		"prettier": "npm:wp-prettier@^3",
		"stylelint": "^17.16.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-scss": "^7.4.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"wp-types": "^4.68.0"
	},
	"allowScripts": {
		"@parcel/watcher@2.5.0": true,
		"fsevents@2.3.3": true,
		"fsevents@2.3.2": true,
		"core-js@3.51.0": true,
		"core-js-pure@3.51.0": true,
		"unrs-resolver@1.12.2": true
	}
}
